User=sam_decoster_baruchmfe
WorkingDirectory=/home/sam_decoster_baruchmfe/microstructure-capstone
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/sam_decoster_baruchmfe/poly-archive/.venv/bin/python -u investigation/cloud_resume.py --raw-bucket poly-capstone-raw --compact-bucket poly-capstone-compact --run-id ordinary-v1-20260927 --plan-object runs/ordinary-v1-20260927/plan-6-workers-reverse-20261001.json --worker-indices 4,5
